{
  "name": "sbee",
  "description": "Simple Buffered Event Emitter",
  "keywords": [
    "event emitter",
    "buffered event emitter"
  ],
  "version": "4.0.0",
  "homepage": "https://github.com/beeblebrox3/sbee",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "author": {
    "email": "mail@luishenrique.dev",
    "name": "Luís Henrique Faria",
    "url": "https://luishenrique.dev/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beeblebrox3/sbee.git"
  },
  "bugs": {
    "url": "https://github.com/beeblebrox3/sbee/issues"
  },
  "files": [
    "docs/*",
    "lib/*"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "directories": {
    "doc": "./docs",
    "lib": "/lib"
  },
  "scripts": {
    "docs": "typedoc",
    "compile": "tsc",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "npm run compile && npm run docs",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "prepublishOnly": "npm run build",
    "preversion": "npm run docs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/node": "^25.6.0",
    "@vitest/coverage-istanbul": "4.1.4",
    "typedoc": "0.28.19",
    "typescript": "6.0.3",
    "vitest": "4.1.4"
  }
}
